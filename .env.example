# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase Database & Auth Configuration
SUPABASE_URL="https://your-supabase-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# AI & Content Pipeline Config
AI_API_KEY="MY_GEMINI_API_KEY"
IMAGE_GENERATION_API_KEY="MY_GEMINI_API_KEY"
CORS_ORIGIN="*"

# VITE_API_BASE_URL: only needed for a SPLIT deployment (frontend on Cloudflare
# Pages, backend on Render/etc). Leave empty for local dev / single-server setup.
# Set at build time in Cloudflare Pages -> Settings -> Environment variables.
VITE_API_BASE_URL=""
